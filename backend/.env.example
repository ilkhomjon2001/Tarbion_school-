# Tarbion backend — muhit sozlamalari
#
# Nusxa oling:  cp .env.example .env
# `.env` git'ga TUSHMAYDI. Yangi kalit qo'shsangiz — shu faylni ham
# yangilang va sherigingizga ayting, aks holda uning muhiti ishlamaydi.
#
# Bu faylda HAQIQIY sekret bo'lmaydi. Repo ochiq.

# --- Umumiy ---
APP_ENV=development
DEBUG=true
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Baza ---
# Format: postgresql+asyncpg://foydalanuvchi:parol@host:port/baza
# docker-compose.yml dagi qiymatlar bilan mos bo'lsin.
DATABASE_URL=postgresql+asyncpg://tarbion:tarbion@localhost:5432/tarbion

# Test uchun alohida baza (pytest shuni ishlatadi, ishchi bazaga tegmaydi)
TEST_DATABASE_URL=postgresql+asyncpg://tarbion:tarbion@localhost:5432/tarbion_test

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth ---
# Kamida 32 belgi. Yangisini shunday yasang:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Har muhitda BOSHQACHA bo'lsin. Bu qiymat namuna — ishlatilmaydi.
JWT_SECRET=ALMASHTIRING__kamida_32_belgi_bolgan_tasodifiy_qator
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# AUT-05: ketma-ket 5 xato urinish → 15 daqiqa blok
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Parol purkashga qarshi: bitta IP dan oynada nechta TURLI login
# bo'yicha xato bo'lgani. Xatolar SONI emas — butun maktab bitta NAT
# ortidan chiqadi va oddiy xatolar hammani bloklab qo'ymasligi kerak.
LOGIN_MAX_LOGINS_PER_IP=15

# --- Cookie (X-4) ---
REFRESH_COOKIE_NAME=tarbion_rt
# Lokalda HTTPS yo'q, shuning uchun false. Ishlab chiqarishda MAJBURIY true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Ishlab chiqarishda: .tarbion.uz
COOKIE_DOMAIN=

# --- CORS ---
# Vergul bilan ajratiladi. "*" ishlatilmaydi — cookie bilan birga ishlamaydi.
CORS_ORIGINS=http://localhost:3000

# --- Proksi ---
# Caddy/nginx ortida turganda `X-Forwarded-For` FAQAT shu manzillardan
# o'qiladi. Bo'sh bo'lsa sarlavha butunlay e'tiborga olinmaydi — aks
# holda har kim o'zini boshqa IP deb ko'rsatib, bloklashni aylanib
# o'tardi. Ishlab chiqarishda: TRUSTED_PROXIES=127.0.0.1/32
TRUSTED_PROXIES=

# --- Domen qoidalari ---
# DAV-03: davomat dars TUGAGANIDAN keyin shuncha soat ustoz uchun ochiq
ATTENDANCE_EDIT_WINDOW_HOURS=24

# --- Fayllar: Cloudflare R2 (T-019) ---
# Hali ulanmagan. Bo'sh qolsa fayl yuklash o'chiq bo'ladi.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRESIGN_TTL_SECONDS=900

# --- Telegram bot (T-017) ---
TELEGRAM_BOT_TOKEN=

# --- To'lov: Payme / Click / Uzum (T-030) ---
# Hali ulanmagan.
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
