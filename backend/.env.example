# Tarbion backend — muhit sozlamalari
#
# Nusxa oling:  cp .env.example .env
# `.env` git'ga TUSHMAYDI. Yangi kalit qo'shsangiz — shu faylni ham
# yangilang va sherigingizga ayting, aks holda uning muhiti ishlamaydi.
#
# Bu faylda HAQIQIY sekret bo'lmaydi. Repo ochiq.

# --- Umumiy ---
APP_ENV=development
DEBUG=true
DISPLAY_TIMEZONE=Asia/Tashkent

# --- Baza ---
# Format: postgresql+asyncpg://foydalanuvchi:parol@host:port/baza
# docker-compose.yml dagi qiymatlar bilan mos bo'lsin.
DATABASE_URL=postgresql+asyncpg://tarbion:tarbion@localhost:5432/tarbion

# Test uchun alohida baza (pytest shuni ishlatadi, ishchi bazaga tegmaydi)
TEST_DATABASE_URL=postgresql+asyncpg://tarbion:tarbion@localhost:5432/tarbion_test

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Auth ---
# Kamida 32 belgi. Yangisini shunday yasang:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Har muhitda BOSHQACHA bo'lsin. Bu qiymat namuna — ishlatilmaydi.
JWT_SECRET=ALMASHTIRING__kamida_32_belgi_bolgan_tasodifiy_qator
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# AUT-05: ketma-ket 5 xato urinish → 15 daqiqa blok
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_ATTEMPT_WINDOW_MINUTES=15
# Parol purkashga qarshi: bitta IP dan oynada nechta TURLI login
# bo'yicha xato bo'lgani. Xatolar SONI emas — butun maktab bitta NAT
# ortidan chiqadi va oddiy xatolar hammani bloklab qo'ymasligi kerak.
LOGIN_MAX_LOGINS_PER_IP=15

# X-14: administrator va direktorga 2FA majburiymi.
# Sukut bo'yicha `true` — xavfsiz standart. Sinov muhitida `false`
# qilinadi: har testda autentifikator ilovasini ochish ish jarayonini
# to'sadi. O'chirilganda 2FA FUNKSIYASI qoladi — kim istasa yoqadi.
REQUIRE_TWO_FACTOR=true

# --- Cookie (X-4) ---
REFRESH_COOKIE_NAME=tarbion_rt
# Lokalda HTTPS yo'q, shuning uchun false. Ishlab chiqarishda MAJBURIY true.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Ishlab chiqarishda: .tarbion.uz
COOKIE_DOMAIN=

# Xabarlarda koʻrsatiladigan sayt manzili («Sayt: ...»).
PUBLIC_SITE_URL=https://tarbion.uz

# --- CORS ---
# Vergul bilan ajratiladi. "*" ishlatilmaydi — cookie bilan birga ishlamaydi.
CORS_ORIGINS=http://localhost:3000

# --- Proksi ---
# Caddy/nginx ortida turganda `X-Forwarded-For` FAQAT shu manzillardan
# o'qiladi. Bo'sh bo'lsa sarlavha butunlay e'tiborga olinmaydi — aks
# holda har kim o'zini boshqa IP deb ko'rsatib, bloklashni aylanib
# o'tardi. Ishlab chiqarishda: TRUSTED_PROXIES=127.0.0.1/32
TRUSTED_PROXIES=

# --- Domen qoidalari ---
# DAV-03: davomat dars TUGAGANIDAN keyin shuncha soat ustoz uchun ochiq
ATTENDANCE_EDIT_WINDOW_HOURS=24

# --- Fayllar: serverning oʻz diski (T-025, MET-03) ---
# Egasining qarori (5-sentabr 2026): Cloudflare R2 oʻrniga server diski.
# Maʼlumot Oʻzbekistonda qoladi va zaxira skriptiga qoʻshiladi.
#
# Nisbiy yoʻl `WorkingDirectory` ga nisbatan hisoblanadi — systemd
# birligida u `/opt/tarbion/backend`, yaʼni sukut boʻyicha fayllar
# `/opt/tarbion/backend/var/files` da. Zaxira skripti ham AYNAN shu
# sukutni ishlatadi, shuning uchun bu qatorni umuman qoʻymasa ham
# boʻladi. Boshqa diskka koʻchirmoqchi boʻlsangiz — toʻliq yoʻl yozing
# va `backup.sh` ga ham oʻsha qiymatni bering.
FILE_STORAGE_DIR=
# MET-03: bitta fayl 200 MB gacha.
FILE_MAX_BYTES=209715200
# X-7: imzolangan havola muddati. Uzaytirilmaydi.
FILE_URL_TTL_SECONDS=900

# --- Telegram bot va xabarnoma worker'i (T-017, T-018) ---
# DIQQAT: bu tokenni tools/task_inbox.py bilan BAHAM KOʻRMANG —
# ikki jarayon bitta tokenni soʻrasa Telegram 409 qaytaradi.
# Token @BotFather dan olinadi. Boʻsh boʻlsa worker ishga tushmaydi,
# lekin navbat toʻplanaveradi — token qoʻyilgach hammasi yetkaziladi.
TELEGRAM_BOT_TOKEN=
# Bot manzili @ siz — kabinet «@nom ni oching» deb koʻrsatadi. Boʻsh
# boʻlsa interfeys ulanishni umuman taklif qilmaydi.
TELEGRAM_BOT_USERNAME=
# Worker navbatni qanchada bir tekshiradi (soniya).
OUTBOX_POLL_SECONDS=30
OUTBOX_BATCH_SIZE=50

# --- To'lov: Payme / Click / Uzum (T-030) ---
# Hali ulanmagan.
PAYME_MERCHANT_ID=
PAYME_KEY=
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- Zaxira nusxa (X-12) ---
# `age` OCHIQ kaliti. Maxfiy kalit SERVERDA TURMAYDI — u parol
# menejerida yoki seyfda. Shunda server buzib kirilsa ham hujumchi
# eski zaxiralarni ocha olmaydi. Batafsil: docs/ZAXIRA.md
#   age-keygen -o backup-key.txt
BACKUP_AGE_RECIPIENT=
BACKUP_DIR=/var/backups/tarbion
BACKUP_KEEP_DAYS=30

# Zaxira YIQILGANDA kimga xabar boradi (administratorning Telegram id si).
# Boʻsh boʻlsa yiqilish faqat jurnalda qoladi — yaʼni amalda hech kim
# bilmaydi. `tarbion-backup-alert.service` shuni oʻqiydi.
BACKUP_ALERT_CHAT_ID=

# Zaxira BOSHQA JOYDA ham turishi shart (X-12). Ikkita yoʻl bor,
# kamida bittasi sozlangan boʻlishi kerak — aks holda `backup.sh`
# ataylab yiqiladi va ogohlantiradi.
#
# 1) Telegram — bot orqali. Fayl allaqachon shifrlangan, ochish kaliti
#    na serverda, na Telegramda. Hisob ham, karta ham kerak emas.
BACKUP_TELEGRAM_CHAT_ID=

# 2) R2 (yoki boshqa S3-mos xotira)
R2_BUCKET=
R2_ENDPOINT=

# Sinov toʻlov provayderi (haqiqiy integratsiyagacha)
SINOV_PROVIDER_KEY=sinov-kalit-almashtiring

# --- E2E (Playwright) ---
# `app.e2e_seed` shu parol bilan `e2e.ustoz` va `e2e.otaona` hisoblarini
# ochadi, Playwright ham shuni ishlatadi. Ikkalasi BIR XIL boʻlsin.
#
# Sekret emas: hisoblar faqat sinov bazasida ochiladi va skript
# `APP_ENV=production` da umuman ishlamaydi. Batafsil: docs/E2E.md
E2E_PASSWORD=
