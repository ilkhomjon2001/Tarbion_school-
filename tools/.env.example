# Telegram task inbox (tools/task_inbox.py)
#
# Nusxa oling:  cp tools/.env.example tools/.env
# `tools/.env` git'ga TUSHMAYDI. Bu faylda HAQIQIY token boʻlmaydi.

# @BotFather bergan token. Bu DEV bot — maktab boti (T-017) bilan
# BIR XIL boʻlmasin: bitta tokenni ikki jarayon `getUpdates` bilan
# soʻrasa Telegram 409 qaytaradi va xabarlar ikkiga boʻlinib ketadi.
TASKS_BOT_TOKEN=

# Ruxsat etilgan guruh(lar). Vergul bilan. Majburiy — usiz bot
# username'ini topgan har kim inbox'ga yoza olardi.
# Topish:  python tools/task_inbox.py --chats
TASKS_CHAT_IDS=
